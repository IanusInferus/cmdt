<Project>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Sub Main</StartupObject>
    <RootNamespace>SECEditor</RootNamespace>
    <AssemblyName>SECEditor</AssemblyName>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <TargetFramework>net48</TargetFramework>
    <ApplicationIcon>2.ico</ApplicationIcon>
    <OptionInfer>On</OptionInfer>
    <OutputPath>..\..\Bin\</OutputPath>
    <BaseIntermediateOutputPath>..\..\Obj\$(MSBuildProjectName)</BaseIntermediateOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <DocumentationFile>SECEditor.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <DocumentationFile>SECEditor.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Firefly.Core">
      <HintPath>..\Lib\Firefly\Firefly.Core.dll</HintPath>
    </Reference>
    <Reference Include="Firefly.GUI">
      <HintPath>..\Lib\Firefly\Firefly.GUI.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="DistrictDataEditor.Designer.vb">
      <DependentUpon>DistrictDataEditor.vb</DependentUpon>
    </Compile>
    <Compile Update="DistrictDataEditor.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="Picker.vb">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Surface.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Surface.Designer.vb">
      <DependentUpon>Surface.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileSystem\FileSystem.vbproj" />
    <ProjectReference Include="..\GraphD3D\GraphD3D.vbproj" />
    <ProjectReference Include="..\GraphSystem\GraphSystem.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="DistrictDataEditor.resx">
      <DependentUpon>DistrictDataEditor.vb</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="Surface.resx">
      <SubType>Designer</SubType>
      <DependentUpon>Surface.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
</Project>
